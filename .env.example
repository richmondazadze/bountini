# Devnet only. Never put server secrets in NEXT_PUBLIC variables.
APP_ORIGIN=http://localhost:3000
# Optional additional exact deployment origins, comma-separated.
APP_ALLOWED_ORIGINS=
DATABASE_URL=
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_WS_URL=wss://api.devnet.solana.com
NEXT_PUBLIC_ESCROW_PROGRAM_ID=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
GEMINI_MODEL=gemini-3.6-flash
# Generate a long random secret. Keep it stable across deployments.
BETTER_AUTH_SECRET=
# Resend sending-only key restricted to your verified domain.
RESEND_API_KEY=
EMAIL_FROM="Bountini <accounts@bountini.us>"
# Private Vercel Blob store token, server-side only. Vercel can also use linked
# BLOB_STORE_ID + rotating VERCEL_OIDC_TOKEN credentials.
BLOB_READ_WRITE_TOKEN=
# Random server secret for the daily abandoned-upload cleanup cron.
CRON_SECRET=
